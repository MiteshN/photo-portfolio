---
import Picture from './Picture.astro';
import { buildRows } from '../lib/layout.ts';
import { photoUrl } from '../lib/manifest.ts';
import type { Photo } from '../lib/types.ts';

interface Props {
  photos: Photo[];
  /** Small text under each photo, e.g. album name and year. */
  meta?: (photo: Photo) => string | undefined;
  /** Load the first row immediately (it's near the top of the page). */
  eagerFirstRow?: boolean;
}

const { photos, meta, eagerFirstRow = false } = Astro.props;
const rows = buildRows(photos, (p) => p.orientation);
const numberOf = new Map(photos.map((p, i) => [p.id, i + 1]));
const pad = (n: number) => String(n).padStart(2, '0');

/** Width hint for the browser, from the slot's column span (of 12, in a 1360px page). */
function sizesFor(column: string): string {
  const span = Number(/span (\d+)/.exec(column)?.[1] ?? 12);
  const px = Math.round((span / 12) * 1360);
  const vw = Math.round((span / 12) * 100);
  return `(max-width: 760px) 100vw, (min-width: 1440px) ${px}px, ${vw}vw`;
}
---

<div class="grid">
  {
    rows.map((row, r) => (
      <div class="row">
        {row.slots.map((slot) => {
          const photo = slot.item;
          const extra = meta?.(photo);
          return (
            <figure class:list={['item', { offset: slot.offset }]} style={`grid-column: ${slot.column}`}>
              <a href={photoUrl(photo)} data-astro-prefetch>
                <Picture photo={photo} sizes={sizesFor(slot.column)} eager={eagerFirstRow && r === 0} />
              </a>
              <figcaption>
                <span class="lead">
                  <span class="num">No. {pad(numberOf.get(photo.id) ?? 0)}</span>
                  <span class="title">{photo.title}</span>
                </span>
                {extra && <span class="meta">{extra}</span>}
              </figcaption>
            </figure>
          );
        })}
      </div>
    ))
  }
</div>

<style>
  .grid {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 96px);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .item.offset {
    margin-top: clamp(0px, 8vw, 120px);
  }

  .item a {
    display: block;
    overflow: hidden;
  }

  .item a :global(img) {
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.4s ease;
  }

  .item a:hover :global(img) {
    transform: scale(1.025);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 12px;
  }

  .lead {
    display: flex;
    gap: 12px;
    align-items: baseline;
    min-width: 0;
  }

  .num {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .meta {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      row-gap: 48px;
    }

    .item {
      grid-column: auto !important;
    }

    .item.offset {
      margin-top: 0;
    }
  }
</style>
